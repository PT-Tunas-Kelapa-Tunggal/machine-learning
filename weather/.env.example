# Copy to .env (git-ignored) and fill in.
SITE_NAME=Tanjung Pinang
LAT=0.92
LON=104.45

# Apple Developer → Certificates, Identifiers & Profiles
WK_TEAM_ID=YOUR_TEAM_ID
WK_KEY_ID=YOUR_KEY_ID
WK_SERVICE_ID=com.weather.krops
# Keep the .p8 outside the repo
WK_KEY_PATH=~/.keys/AuthKey_YOUR_KEY_ID.p8

# Optional
# BMKG_ADM4=21.72.01.1001   # kelurahan code for the BMKG public forecast API
# BMKG_SHIFT_DAYS=-1        # if BMKG files each 07:00 reading under the morning it was read
# USE_OPEN_METEO=1          # free API is non-commercial only; off by default
